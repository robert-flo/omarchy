{
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": false,
    "showStatusIndicators": false,
    "showStatusLineRunningTime": false,
    "mode": "zen"
  },
  "notifications": true,
  "hints": true,
  "modelSlashCommands": true,
  "steering": true,
  "rewind": true,
  "model": {
    "modelId": "default",
    "displayModelId": "auto",
    "displayName": "Auto",
    "displayNameShort": "Auto",
    "aliases": [
      "auto"
    ],
    "maxMode": false
  },
  "hasChangedDefaultModel": false,
  "modelParameters": {
    "default": []
  },
  "selectedModel": {
    "modelId": "default",
    "parameters": []
  },
  "modelSelectionHistory": [
    "default"
  ],
  "exploreSubagentModel": "default",
  "privacyCache": {
    "ghostMode": false,
    "privacyMode": 0,
    "updatedAt": 0
  },
  "autoReviewAvailabilityCache": {
    "backendUrl": "",
    "authCacheKey": "",
    "available": true,
    "updatedAt": 0
  },
  "serverConfigCache": {
    "backendUrl": "",
    "authCacheKey": "",
    "agentUrlConfig": {
      "agentUrl": "",
      "agentnUrl": ""
    },
    "cliSandboxDefaultEnabled": false,
    "serverHttp2Config": 0,
    "updatedAt": 0
  },
  "authInfo": {
    "email": "",
    "displayName": "",
    "userId": "",
    "authId": ""
  },
  "network": {
    "useHttp1ForAgent": false
  },
  "approvalMode": "unrestricted",
  "autoAcceptWebSearch": true,
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "runEverythingSettingsPromptStreak": 1,
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  },
  "permissions": {
    "allow": [
      "Shell(*)",
      "Read(**/*)",
      "Read(/*)",
      "Write(**/*)",
      "Write(/*)",
      "WebFetch(*)",
      "Mcp(*:*)"
    ],
    "deny": []
  }
}
