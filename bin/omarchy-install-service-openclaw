#!/bin/bash

# omarchy:summary=Install and enable the OpenClaw gateway systemd user service (dashboard on 127.0.0.1:18789)
# omarchy:examples=omarchy install openclaw service

# The OpenClaw CLI itself is provisioned lazily via mise (see install/user/mise.sh:
# omarchy-mise-install npm:openclaw openclaw). This command installs the gateway
# daemon that backs the OpenClaw Dashboard launcher (a webapp on 127.0.0.1:18789).
#
# The unit is generated by `openclaw gateway install` because its ExecStart must
# point at the machine's own mise node runtime path, which is unknown until the
# CLI is present. This deliberately does not run from a first-use stub: a systemd
# user service should not silently spring to life from a launcher.

set -euo pipefail

if omarchy-cmd-missing openclaw; then
  echo "openclaw is not installed. Run the OpenClaw TUI launcher once to install it, then retry." >&2
  exit 1
fi

echo "Installing the OpenClaw gateway systemd user service..."
openclaw gateway install

echo "Enabling the gateway service..."
systemctl --user enable --now openclaw-gateway

if systemctl --user is-active --quiet openclaw-gateway; then
  echo ""
  echo "OpenClaw gateway running: http://127.0.0.1:18789"
else
  echo ""
  echo "OpenClaw gateway unit installed but not active yet." >&2
  exit 1
fi
