#!/bin/bash

# omarchy:summary=Install listed Arch and AUR packages that are not on the system yet
# omarchy:args=[--repos|--aur]
# omarchy:examples=omarchy pkg sync | omarchy pkg sync --repos | omarchy pkg sync --aur
# omarchy:requires-sudo=true

set -euo pipefail

if (( $# > 1 )); then
  echo "Usage: omarchy pkg sync [--repos|--aur]" >&2
  exit 1
fi

sync_from() {
  local file="$1"
  local adder="$2"
  local packages=()
  local missing=()
  local pkg

  if [[ ! -f $file ]]; then
    echo "Missing package list: $file" >&2
    return 1
  fi

  mapfile -t packages < <(sed -e 's/[[:space:]]*#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$file")
  for pkg in "${packages[@]}"; do
    # omarchy-pkg-add installs every name it is given once any one is missing.
    # A name that pacman already resolves (including via Provides) must stay
    # out of that transaction, or a provider such as ex-vi-compat blocks it.
    if omarchy-pkg-missing "$pkg"; then
      missing+=("$pkg")
    fi
  done
  if (( ${#missing[@]} == 0 )); then
    return 0
  fi
  "$adder" "${missing[@]}"
}

lists="$OMARCHY_PATH/install"

case "${1:-}" in
  --repos)
    sync_from "$lists/omarchy-base.packages" omarchy-pkg-add
    ;;
  --aur)
    sync_from "$lists/omarchy-aur.packages" omarchy-pkg-aur-add
    ;;
  "")
    sync_from "$lists/omarchy-base.packages" omarchy-pkg-add
    sync_from "$lists/omarchy-aur.packages" omarchy-pkg-aur-add
    ;;
  *)
    echo "Usage: omarchy pkg sync [--repos|--aur]" >&2
    exit 1
    ;;
esac
