#!/bin/bash

# omarchy:summary=Personal fork: install every binary the 78 Omarchy launchers run (idempotent, per-user)
# omarchy:args=
# omarchy:examples=omarchy personal-bootstrap-launchers | bash <(curl -fsSL https://raw.githubusercontent.com/omarchy-personal/omarchy-installer/personal/bin/omarchy-personal-bootstrap-launchers)

# Personal bootstrap for the launchers harvested from RaVN into the personal
# fork. It makes the Exec line of every .desktop file resolve, nothing more:
# it installs dependencies and CLI runtimes, creates the ~/src working
# directory the launchers cd into, and wires the few that need a PATH/wrapper
# shim. It never touches launchers or the personal package.
#
# Idempotent: safe to re-run on an already-converged machine (each step is
# guarded by `command -v` / file-existence checks). Logs what it does and
# prints a summary of what still could not be resolved.

set -euo pipefail

HOME_BN="$HOME/.local/bin"
MISE_SHIMS="$HOME/.local/share/mise/shims"
export PATH="$HOME/.local/bin:$MISE_SHIMS:$HOME/.mimocode/bin:$PATH"

missing=()
note() { printf '\033[0;34m[personal-bootstrap]\033[0m %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

mkdir -p "$HOME/src" "$HOME_BN"

# ---------------------------------------------------------------------------
# System packages (official Arch + personal AUR additions)
# ---------------------------------------------------------------------------
if have pacman; then
  note "pacman: ensuring base launcher deps"
  sudo pacman -S --needed --noconfirm ncdu kitty dua-cli spotify-launcher >/dev/null
fi

# AUR helper must exist for the personal AUR packages. yay is out of repo
# scope; where it is missing, the steps below are skipped with a warning.
if have yay; then
  note "yay: ensuring launcher deps from the AUR"
  yay -S --needed --noconfirm microsoft-edge-stable-bin lyricify spicetify-cli >/dev/null
else
  missing+=(microsoft-edge-stable lyricify spicetify)
  note "yay not found; skipping AUR packages (microsoft-edge-stable, lyricify, spicetify)"
fi

# ---------------------------------------------------------------------------
# Hermes CLI (omarchy canonical installer; the Web/TUI launchers resolve it)
# ---------------------------------------------------------------------------
if have omarchy-install-hermes-cli; then
  note "hermes: ensuring omarchy hermes CLI wrapper"
  omarchy-install-hermes-cli --now || true
fi

# The Hermes Web launcher execs ~/.hermes/hermes-agent/venv/bin/hermes, i.e.
# the path the hermes-desktop package owns. With the CLI install the venv has
# a different home (mise pipx), so when nothing is at that path yet we shim it
# to the wrapper on PATH -- the same command the TUI launcher runs.
VENV_HERMES="$HOME/.hermes/hermes-agent/venv/bin/hermes"
if [[ ! -e "$VENV_HERMES" ]] && have hermes; then
  note "hermes: shimming the launcher venv path to the CLI wrapper"
  mkdir -p "$(dirname "$VENV_HERMES")"
  printf '#!/usr/bin/env bash\n# omarchy-personal-bootstrap: shim to the mise-backed hermes CLI\nif [[ -x "$HOME/.local/bin/hermes" ]]; then exec "$HOME/.local/bin/hermes" "$@"; fi\nexec hermes "$@"\n' >"$VENV_HERMES"
  chmod +x "$VENV_HERMES"
fi

# ---------------------------------------------------------------------------
# mise runtimes + CLIs (qwen, opencode, codex, oh-my-pi, antigravity, grok)
# ---------------------------------------------------------------------------
if have mise; then
  note "mise: ensuring runtimes (node) and AI CLIs"
  mise use -g --quiet node@latest || true
  for tool in 'qwen' 'opencode' 'codex' 'oh-my-pi' 'antigravity-cli' 'npm:@xai-official/grok'; do
    mise use -g --quiet "$tool" || missing+=("$tool")
  done
  mise reshim || true

  # Wrappers that pin the exact binary a launcher execs, so later mise updates
  # to the same tool cannot silently change the Exec target.
  cat >"$HOME_BN/agy" <<'EOF'
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "antigravity-cli" || exit 1
exec mise x "antigravity-cli" -- "agy" "$@"
EOF
  chmod +x "$HOME_BN/agy"

  cat >"$HOME_BN/grok" <<'EOF'
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet "npm:@xai-official/grok" || exit 1
exec mise x "npm:@xai-official/grok" -- "grok" "$@"
EOF
  chmod +x "$HOME_BN/grok"

  # npm deps under the mise node runtime (openclaude, zero, command-code).
  if have npm; then
    note "npm: ensuring openclaude, zero and command-code"
    npm install -g @gitlawb/openclaude@latest @gitlawb/zero command-code >/dev/null || true
    mise reshim || true
  fi
else
  missing+=(mise qwen opencode codex omp agy grok openclaude zero cmd)
  note "mise not found; skipping mise/npm CLIs (install mise first)"
fi

# ---------------------------------------------------------------------------
# Official installers (mimo, openclaw, opencode-desktop AppImage)
# ---------------------------------------------------------------------------
if [[ ! -x "$HOME/.mimocode/bin/mimo" ]]; then
  note "mimo: installing via official installer"
  curl -fsSL https://mimo.xiaomi.com/install | bash || true
fi
if [[ -x "$HOME/.mimocode/bin/mimo" ]]; then
  printf '#!/usr/bin/env bash\nexec "$HOME/.mimocode/bin/mimo" "$@"\n' >"$HOME_BN/mimo"
  chmod +x "$HOME_BN/mimo"
else
  missing+=(mimo)
fi

if have openclaw; then
  :
elif have npm; then
  note "openclaw: installing via official installer"
  curl -fsSL https://openclaw.ai/install.sh | bash -s -- --no-prompt --no-onboard || true
fi
if have openclaw && ! systemctl --user is-enabled openclaw-gateway >/dev/null 2>&1; then
  note "openclaw: installing + enabling the gateway service (dashboard 127.0.0.1:18789)"
  openclaw gateway install >/dev/null 2>&1 || true
  systemctl --user enable --now openclaw-gateway >/dev/null 2>&1 || true
fi

OD_TARGET="$HOME/.local/opt/opencode-desktop/opencode-desktop.AppImage"
if [[ ! -e "$HOME_BN/opencode-desktop" ]]; then
  if [[ ! -e "$OD_TARGET" ]]; then
    note "opencode-desktop: downloading official AppImage"
    mkdir -p "$HOME/.local/opt/opencode-desktop"
    curl -fsSL -o "$OD_TARGET" https://github.com/anomalyco/opencode/releases/latest/download/opencode-desktop-linux-x86_64.AppImage || true
    chmod +x "$OD_TARGET" || true
  fi
  if [[ -x "$OD_TARGET" ]]; then
    printf '#!/usr/bin/env bash\nAPP="$HOME/.local/opt/opencode-desktop/opencode-desktop.AppImage"\nif [[ -e /dev/fuse ]]; then exec "$APP" "$@"; else exec "$APP" --appimage-extract-and-run "$@"; fi\n' >"$HOME_BN/opencode-desktop"
    chmod +x "$HOME_BN/opencode-desktop"
    # Validate the AppImage actually executes (FUSE or bundled runtime).
    "$OD_TARGET" --appimage-version >/dev/null 2>&1 || rm -f "$HOME_BN/opencode-desktop"
  else
    missing+=(opencode-desktop)
  fi
fi

# ---------------------------------------------------------------------------
# Final sweep + summary
# ---------------------------------------------------------------------------
check() { have "$1" || missing+=("$1"); }
for b in foot imv mpv kitty lyricify ncdu dua microsoft-edge-stable spotify-launcher herdr \
         mimo openclaw openclaude zero cmd qwen agy grok omp opencode codex hermes \
         hermes-dashboard-path xdg-terminal-exec omarchy-launch-webapp omarchy-launch-docker-tui \
         omarchy-webapp-handler-hey omarchy-webapp-handler-zoom opencode-desktop; do
  case "$b" in
    hermes-dashboard-path) [[ -e "$VENV_HERMES" ]] || missing+=("hermes-web-venv") ;;
    omarchy-launch-* | omarchy-webapp-handler-*) have "$b" || missing+=("$b") ;;
    *) check "$b" ;;
  esac
done

if [[ ${#missing[@]} -eq 0 ]]; then
  note "done: every launcher binary resolves."
else
  note "done with gaps: ${missing[*]}"
  note "re-run this script after satisfying those dependencies."
fi